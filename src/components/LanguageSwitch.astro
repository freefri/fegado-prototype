---
import { languages, type Lang } from "@/i18n/ui";
import { getLangFromUrl, translatePath, useTranslations } from "@/i18n/utils";
import { cn } from "@/lib/utils";

interface Props {
  class?: string;
}

const current = getLangFromUrl(Astro.url);
const t = useTranslations(current);
const codes = Object.keys(languages) as Lang[];
---

<ul aria-label={t("lang.label")} class={cn("m-0 flex list-none gap-1 p-0 text-[13px]", Astro.props.class)}>
  {codes.map((code) => (
    <li>
      <a
        href={translatePath(Astro.url, code)}
        hreflang={code}
        lang={code}
        title={languages[code]}
        aria-current={code === current ? "true" : undefined}
        class="rounded-full border border-transparent px-2 py-1 uppercase no-underline hover:border-chip-border aria-[current=true]:bg-chip aria-[current=true]:text-chip-ink"
      >
        {code}
      </a>
    </li>
  ))}
</ul>
