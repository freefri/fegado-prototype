---
import { Menu, User } from "@lucide/astro";
import Logo from "./Logo.astro";
import LanguageSwitch from "./LanguageSwitch.astro";
import { buttonVariants } from "@/components/ui/button";
import { links } from "@/data/site";
import { aboutPages, transparencyPages, type RouteKey } from "@/i18n/routes";
import { getLangFromUrl, isRouteActive, localizePath, routePath, useTranslations } from "@/i18n/utils";
import type { UiKey } from "@/i18n/ui";
import { cn } from "@/lib/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const home = localizePath("/", lang);

interface Link {
  label: string;
  href: string;
  active?: boolean;
}
type NavItem = Link | { label: string; active: boolean; children: Link[] };

const page = (key: RouteKey, label: UiKey): Link => ({ label: t(label), href: routePath(key, lang), active: isRouteActive(Astro.url, key) });
const aboutLabels = { "who-we-are": "nav.whoWeAre", disciplines: "nav.disciplines", join: "nav.join" } as const;
const transparencyLabels = { board: "nav.board", documents: "nav.documents", identity: "nav.identity" } as const;

const nav: NavItem[] = [
  { label: t("nav.about"), active: isRouteActive(Astro.url, "about"), children: aboutPages.map((key) => page(key, aboutLabels[key])) },
  { label: t("nav.events"), href: `${home}#eventos` },
  page("news", "nav.news"),
  page("clubs", "nav.clubs"),
  {
    label: t("nav.transparency"),
    active: isRouteActive(Astro.url, "transparency"),
    children: transparencyPages.map((key) => page(key, transparencyLabels[key])),
  },
  page("contact", "nav.contact"),
];

const itemClass = "rounded-full px-[15px] py-[9px] text-[15px] no-underline transition-colors hover:bg-chip hover:text-chip-ink";
const activeClass = "bg-chip text-chip-ink";
---

<header class="site-header relative z-20">
  <div class="mx-auto flex h-[76px] max-w-[1440px] items-center gap-6 px-4 md:h-[93px] md:px-10 xl:px-[75px]">
    <Logo class="w-[120px] md:w-[150px]" />

    <nav
      id="main-nav"
      aria-label={t("nav.label")}
      class="absolute inset-x-0 top-full hidden flex-col bg-white px-4 pt-3 pb-5 shadow-lg data-[open=true]:flex md:px-10 lg:static lg:mx-auto lg:flex lg:flex-row lg:items-center lg:gap-1 lg:bg-transparent lg:p-0 lg:shadow-none"
    >
      {nav.map((item) =>
        "children" in item ? (
          <div class="submenu relative">
            <button type="button" class={cn(itemClass, "peer group flex w-full cursor-pointer items-center gap-2 text-left lg:w-auto", item.active && activeClass)} aria-expanded="false">
              {item.label}
              <span aria-hidden="true" class="inline-block size-[5px] -translate-y-[2px] rotate-45 border-r-[1.3px] border-b-[1.3px] border-current transition-transform group-aria-expanded:translate-y-px group-aria-expanded:-rotate-135" />
            </button>
            <ul class="m-0 hidden list-none py-1 pl-4 lg:absolute lg:top-full lg:left-0 lg:mt-1 lg:min-w-[250px] lg:rounded-md lg:bg-white lg:p-1.5 lg:shadow-[0_8px_24px_rgb(19_68_130/0.16)] peer-aria-expanded:block">
              {item.children.map((child) => (
                <li>
                  <a href={child.href} class={cn("block rounded px-3 py-2 text-sm no-underline hover:bg-chip hover:text-chip-ink", child.active && "font-semibold text-chip-ink")} aria-current={child.active ? "page" : undefined}>
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ) : (
          <a href={item.href} class={cn(itemClass, item.active && activeClass)} aria-current={item.active ? "page" : undefined}>{item.label}</a>
        ),
      )}
      <LanguageSwitch class="mt-3 px-[15px] lg:hidden" />
    </nav>

    <div class="ml-auto hidden items-center gap-5 lg:flex">
      <LanguageSwitch />
      <a class={buttonVariants()} href={links.intranet}><User />{t("nav.personalArea")}</a>
    </div>

    <button
      type="button"
      class="menu-toggle ml-auto cursor-pointer p-2 text-ink lg:hidden"
      aria-controls="main-nav"
      aria-expanded="false"
      aria-label={t("nav.openMenu")}
    >
      <Menu class="size-[26px]" />
    </button>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const nav = document.getElementById("main-nav");
  toggle?.addEventListener("click", () => {
    const open = nav?.dataset.open !== "true";
    if (nav) nav.dataset.open = String(open);
    toggle.setAttribute("aria-expanded", String(open));
  });

  const submenuButtons = [...document.querySelectorAll<HTMLButtonElement>(".submenu > button")];
  const closeSubmenus = (except?: HTMLButtonElement) =>
    submenuButtons.filter((button) => button !== except).forEach((button) => button.setAttribute("aria-expanded", "false"));

  for (const button of submenuButtons) {
    button.addEventListener("click", () => {
      closeSubmenus(button);
      button.setAttribute("aria-expanded", String(button.getAttribute("aria-expanded") !== "true"));
    });
  }
  document.addEventListener("click", (event) => {
    if (!(event.target as Element).closest(".submenu")) closeSubmenus();
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeSubmenus();
  });
</script>
