---
import { getCollection } from "astro:content";
import { CalendarDays, ChevronLeft, ChevronRight, LayoutGrid, ListFilter, Search } from "@lucide/astro";
import EventsCta from "./EventsCta.astro";
import FilterChip from "./FilterChip.astro";
import EventCard from "@/components/home/EventCard.astro";
import { buttonVariants } from "@/components/ui/button";
import Base from "@/layouts/Base.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import { eventPath, getSortedEvents, type EventEntry } from "@/lib/events";
import { localDate } from "@/lib/format";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const events = await getSortedEvents();

// Events name their club as the live site writes it, so clubs are matched without case or accents.
const fold = (text: string) => text.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase().trim();
const provinceOf = new Map((await getCollection("clubs")).map(({ data }) => [fold(data.name), data.province]));

const iso = (date: Date) => {
  const { year, month, day } = localDate(date);
  return `${year}-${String(month).padStart(2, "0")}-${String(day).padStart(2, "0")}`;
};
const attrs = (event: EventEntry) => ({
  "data-event": "",
  "data-date": iso(event.data.date),
  "data-club": event.data.club,
  "data-province": provinceOf.get(fold(event.data.club)) ?? "",
  "data-discipline": event.data.discipline,
  "data-type": event.data.official ? "official" : "unofficial",
  "data-search": fold(`${event.data.title} ${event.data.club}`),
});

const unique = (values: string[]) => [...new Set(values.filter(Boolean))].sort((a, b) => a.localeCompare(b, lang));
const clubs = unique(events.map((event) => event.data.club)).map((club) => ({ value: club, label: club }));
const provinces = unique(events.map((event) => provinceOf.get(fold(event.data.club)) ?? "")).map((p) => ({ value: p, label: p }));
const disciplines = [...new Set(events.map((event) => event.data.discipline))].map((d) => ({ value: d, label: t(`discipline.${d}`) }));
const types = [
  { value: "official", label: t("events.official") },
  { value: "unofficial", label: t("events.unofficial") },
];

// One month grid per month with events, weeks from Monday, as in the design's calendar view.
const monthNames = t("calendar.months").split(",");
const dayNames = t("calendar.days").split(",");
const months = [...new Set(events.map((event) => iso(event.data.date).slice(0, 7)))].map((key) => {
  const [year, month] = key.split("-").map(Number);
  const first = new Date(Date.UTC(year, month - 1, 1));
  const start = new Date(first);
  start.setUTCDate(1 - ((first.getUTCDay() + 6) % 7));
  const days = Array.from({ length: 42 }, (_, i) => {
    const day = new Date(start);
    day.setUTCDate(start.getUTCDate() + i);
    const date = day.toISOString().slice(0, 10);
    return { date, number: day.getUTCDate(), inMonth: day.getUTCMonth() === month - 1, events: events.filter((event) => iso(event.data.date) === date) };
  });
  // Six rows fit any month; trailing weeks that lie wholly in the next month are dropped.
  while (days.slice(-7).every((day) => !day.inMonth)) days.splice(-7);
  return { key, title: t("calendar.title", { month: monthNames[month - 1], year }), days };
});

const toolButton = "grid size-[34px] cursor-pointer place-items-center rounded-full border border-chip-ink text-chip-ink";
---

<Base title={`${t("eventsPage.title")} · FEGADO`}>
  <section class="events-page mx-auto max-w-[1440px] px-4 pt-10 pb-20 md:px-10 md:pt-14 xl:px-[75px]">
    <h1 class="mb-6 text-[34px] md:text-[44px]">{t("eventsPage.title")}</h1>
    <p class="mb-8 max-w-[560px] text-[15px] leading-[1.55] font-light text-ink-soft">{t("eventsPage.intro")}</p>

    <div class="mb-4 flex flex-wrap items-center gap-2.5">
      <label class="relative w-full max-w-[320px]">
        <span class="sr-only">{t("eventsPage.search")}</span>
        <Search class="pointer-events-none absolute top-1/2 left-3.5 size-3.5 -translate-y-1/2 text-ink-soft" />
        <input type="search" name="q" placeholder={t("eventsPage.search")} class="h-[34px] w-full rounded-full border border-chip-ink/70 bg-white pr-3 pl-9 text-[13px] placeholder:text-ink-soft" />
      </label>
      <button type="button" class:list={[toolButton, "filters-toggle bg-white aria-expanded:bg-chip-ink aria-expanded:text-white"]} aria-expanded="false" aria-controls="event-filters" aria-label={t("documents.filters")}>
        <ListFilter class="size-4" />
      </button>
      <div class="ml-auto flex rounded-full border border-chip-ink p-0.5" role="group" aria-label={t("eventsPage.view")}>
        <button type="button" class="view-toggle grid size-[30px] cursor-pointer place-items-center rounded-full text-chip-ink aria-pressed:bg-chip-ink aria-pressed:text-white" data-view="grid" aria-pressed="true" aria-label={t("eventsPage.grid")}><LayoutGrid class="size-4" /></button>
        <button type="button" class="view-toggle grid size-[30px] cursor-pointer place-items-center rounded-full text-chip-ink aria-pressed:bg-chip-ink aria-pressed:text-white" data-view="calendar" aria-pressed="false" aria-label={t("eventsPage.calendar")}><CalendarDays class="size-4" /></button>
      </div>
    </div>

    <div id="event-filters" class="mb-8 hidden flex-wrap items-center gap-2 data-[open=true]:flex">
      <FilterChip label={t("eventsPage.club")} name="club" options={clubs} />
      <FilterChip label={t("eventsPage.province")} name="province" options={provinces} />
      <FilterChip label={t("eventsPage.date")} name="date">
        <div class="grid gap-2 p-2.5 text-sm">
          <label class="grid gap-1">{t("eventsPage.from")}<input type="date" name="from" class="rounded-md border border-chip-border px-2 py-1" /></label>
          <label class="grid gap-1">{t("eventsPage.to")}<input type="date" name="to" class="rounded-md border border-chip-border px-2 py-1" /></label>
        </div>
      </FilterChip>
      <FilterChip label={t("eventsPage.discipline")} name="discipline" options={disciplines} />
      <FilterChip label={t("eventsPage.type")} name="type" options={types} />
      <button type="button" class="filters-clear hidden cursor-pointer px-2 text-[13px] font-semibold text-chip-ink hover:underline">{t("documents.clear")}</button>
    </div>

    <p class="events-status sr-only" aria-live="polite" data-template={t("eventsPage.results")}></p>

    <div class="events-grid">
      <div class="grid gap-[30px] md:grid-cols-2 xl:grid-cols-3">
        {events.map((event) => <EventCard event={event} attrs={attrs(event)} />)}
      </div>
      <p class="events-empty mt-6 hidden rounded-md bg-chip px-4 py-3 text-sm text-chip-ink">{t("eventsPage.noResults")}</p>
      <div class="mt-12 text-center">
        <button type="button" class:list={[buttonVariants({ variant: "dark" }), "events-more"]}>{t("eventsPage.more")}</button>
      </div>
    </div>

    <div class="events-calendar hidden">
      {months.map((month) => (
        <section class="calendar-month hidden" data-month={month.key} aria-label={month.title}>
          <div class="mb-4 flex items-center justify-between">
            <h2 class="text-[30px]">{month.title}</h2>
            <div class="flex gap-1">
              <button type="button" class="calendar-prev grid size-9 cursor-pointer place-items-center rounded-full hover:bg-chip disabled:cursor-default disabled:opacity-30" aria-label={t("calendar.previous")}><ChevronLeft class="size-5" /></button>
              <button type="button" class="calendar-next grid size-9 cursor-pointer place-items-center rounded-full hover:bg-chip disabled:cursor-default disabled:opacity-30" aria-label={t("calendar.next")}><ChevronRight class="size-5" /></button>
            </div>
          </div>
          <div class="overflow-x-auto rounded-[14px] border border-chip-border bg-white">
            <div class="grid min-w-[760px] grid-cols-7">
              {dayNames.map((day) => <div class="bg-chip px-3 py-2 text-xs font-semibold text-chip-ink uppercase">{day}</div>)}
              {month.days.map((day) => (
                <div class:list={["min-h-[110px] border-t border-l border-chip p-2 [&:nth-child(7n+1)]:border-l-0", !day.inMonth && "bg-chip/40 text-muted"]}>
                  <span class="mb-1.5 block font-heading text-lg">{day.number}</span>
                  {day.inMonth && day.events.length > 0 && (
                    <ul class="m-0 grid list-none gap-1 p-0">
                      {day.events.map((event) => (
                        <li {...attrs(event)}>
                          <a href={eventPath(lang, event)} class="line-clamp-2 rounded-md bg-chip px-2 py-1 text-[11px] leading-tight text-chip-ink no-underline hover:bg-chip-border">{event.data.title}</a>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              ))}
            </div>
          </div>
        </section>
      ))}
    </div>
  </section>
  <EventsCta />
</Base>

<script>
  const PAGE = 9;
  const page = document.querySelector<HTMLElement>(".events-page");
  if (page) {
    const fold = (text: string) => text.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
    const search = page.querySelector<HTMLInputElement>("input[name=q]")!;
    const filters = page.querySelector<HTMLElement>("#event-filters")!;
    const toggle = page.querySelector<HTMLButtonElement>(".filters-toggle")!;
    const clear = page.querySelector<HTMLButtonElement>(".filters-clear")!;
    const more = page.querySelector<HTMLButtonElement>(".events-more")!;
    const status = page.querySelector<HTMLElement>(".events-status")!;
    const grid = page.querySelector<HTMLElement>(".events-grid > div")!;
    const cards = [...grid.querySelectorAll<HTMLElement>("[data-event]")];
    const chips = [...page.querySelectorAll<HTMLElement>(".events-calendar [data-event]")];
    const months = [...page.querySelectorAll<HTMLElement>(".calendar-month")];
    let shown = PAGE;

    // Upcoming events first, then the past ones from the latest; done here so it follows the reader's day.
    const today = new Date().toISOString().slice(0, 10);
    const upcoming = cards.filter((card) => card.dataset.date! >= today);
    const past = cards.filter((card) => card.dataset.date! < today).reverse();
    grid.append(...upcoming, ...past);
    const ordered = [...upcoming, ...past];

    const checked = (name: string) => [...filters.querySelectorAll<HTMLInputElement>(`input[name=${name}]:checked`)].map((input) => input.value);
    const dateValue = (name: string) => filters.querySelector<HTMLInputElement>(`input[name=${name}]`)!.value;

    function matches(element: HTMLElement) {
      const words = fold(search.value).split(/\s+/).filter(Boolean);
      const data = element.dataset;
      const from = dateValue("from");
      const to = dateValue("to");
      return (
        words.every((word) => data.search!.includes(word)) &&
        (["club", "province", "discipline", "type"] as const).every((name) => {
          const values = checked(name);
          return values.length === 0 || values.includes(data[name] ?? "");
        }) &&
        (!from || data.date! >= from) &&
        (!to || data.date! <= to)
      );
    }

    function update() {
      const visible = ordered.filter(matches);
      ordered.forEach((card) => (card.hidden = true));
      visible.slice(0, shown).forEach((card) => (card.hidden = false));
      chips.forEach((chip) => (chip.hidden = !matches(chip)));
      more.hidden = visible.length <= shown;
      page!.querySelector(".events-empty")!.classList.toggle("hidden", visible.length > 0);
      status.textContent = status.dataset.template!.replace("{count}", String(visible.length));

      let active = false;
      for (const chip of filters.querySelectorAll<HTMLElement>(".filter-chip")) {
        const name = chip.dataset.filter!;
        const button = chip.querySelector<HTMLElement>("button")!;
        const labels = [...chip.querySelectorAll<HTMLInputElement>("input:checked")].map((input) => input.dataset.optionLabel!);
        const range = name === "date" && [dateValue("from"), dateValue("to")].filter(Boolean).join(" – ");
        const summary = range || (labels.length ? labels[0] + (labels.length > 1 ? ` +${labels.length - 1}` : "") : "");
        chip.querySelector(".filter-chip-label")!.textContent = summary ? `${button.dataset.label}: ${summary}` : button.dataset.label!;
        button.dataset.active = String(Boolean(summary));
        active ||= Boolean(summary);
      }
      clear.classList.toggle("hidden", !active);
    }

    search.addEventListener("input", () => ((shown = PAGE), update()));
    filters.addEventListener("change", () => ((shown = PAGE), update()));
    more.addEventListener("click", () => ((shown += PAGE), update()));
    clear.addEventListener("click", () => {
      filters.querySelectorAll<HTMLInputElement>("input").forEach((input) => (input.type === "checkbox" ? (input.checked = false) : (input.value = "")));
      shown = PAGE;
      update();
    });
    toggle.addEventListener("click", () => {
      const open = filters.dataset.open !== "true";
      filters.dataset.open = String(open);
      toggle.setAttribute("aria-expanded", String(open));
    });

    const chipButtons = [...filters.querySelectorAll<HTMLButtonElement>(".filter-chip > button")];
    for (const button of chipButtons) {
      button.addEventListener("click", () => {
        const open = button.getAttribute("aria-expanded") !== "true";
        chipButtons.forEach((other) => other.setAttribute("aria-expanded", "false"));
        button.setAttribute("aria-expanded", String(open));
      });
    }
    document.addEventListener("click", (event) => {
      if (!(event.target as Element).closest(".filter-chip")) chipButtons.forEach((button) => button.setAttribute("aria-expanded", "false"));
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") chipButtons.forEach((button) => button.setAttribute("aria-expanded", "false"));
    });

    // Calendar: opens on the current month, or the closest month that has events.
    const thisMonth = today.slice(0, 7);
    let current = months.findIndex((month) => month.dataset.month! >= thisMonth);
    if (current === -1) current = months.length - 1;
    const showMonth = (index: number) => {
      current = index;
      months.forEach((month, i) => {
        month.classList.toggle("hidden", i !== index);
        month.querySelector<HTMLButtonElement>(".calendar-prev")!.disabled = i === 0;
        month.querySelector<HTMLButtonElement>(".calendar-next")!.disabled = i === months.length - 1;
      });
    };
    page.querySelectorAll(".calendar-prev").forEach((button) => button.addEventListener("click", () => showMonth(current - 1)));
    page.querySelectorAll(".calendar-next").forEach((button) => button.addEventListener("click", () => showMonth(current + 1)));
    showMonth(current);

    for (const button of page.querySelectorAll<HTMLButtonElement>(".view-toggle")) {
      button.addEventListener("click", () => {
        const calendar = button.dataset.view === "calendar";
        page.querySelectorAll(".view-toggle").forEach((other) => other.setAttribute("aria-pressed", String(other === button)));
        page.querySelector(".events-grid")!.classList.toggle("hidden", calendar);
        page.querySelector(".events-calendar")!.classList.toggle("hidden", !calendar);
      });
    }

    update();
  }
</script>
