---
import { Eye, EyeOff } from "@lucide/astro";
import { input } from "./fields";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

interface Props {
  id: string;
  name: string;
  autocomplete: "current-password" | "new-password";
  required?: boolean;
}

const t = useTranslations(getLangFromUrl(Astro.url));
const { id, name, autocomplete, required } = Astro.props;
---

<div class="password-input relative">
  <input class={`${input} pr-10`} id={id} name={name} type="password" autocomplete={autocomplete} required={required} minlength={8} />
  <button type="button" class="group absolute top-1/2 right-2 grid size-7 -translate-y-1/2 cursor-pointer place-items-center rounded-full text-chip-ink hover:bg-chip" aria-pressed="false" aria-label={t("account.showPassword")}>
    <Eye class="size-4 group-aria-pressed:hidden" />
    <EyeOff class="hidden size-4 group-aria-pressed:block" />
  </button>
</div>

<script>
  for (const wrapper of document.querySelectorAll<HTMLElement>(".password-input")) {
    const field = wrapper.querySelector("input")!;
    const toggle = wrapper.querySelector("button")!;
    toggle.addEventListener("click", () => {
      const show = field.type === "password";
      field.type = show ? "text" : "password";
      toggle.setAttribute("aria-pressed", String(show));
    });
  }
</script>
