---
import { getEntry, render } from "astro:content";
import ContactCta from "./ContactCta.astro";
import Gallery from "./Gallery.astro";
import ImageStack from "./ImageStack.astro";
import LinkButton from "./LinkButton.astro";
import PageIntro from "./PageIntro.astro";
import Question from "./Question.astro";
import BoardMembers from "@/components/board/BoardMembers.astro";
import Documents from "@/components/documents/Documents.astro";
import OrganismLogos from "@/components/documents/OrganismLogos.astro";
import Base from "@/layouts/Base.astro";
import { aboutPages, transparencyPages, type RouteKey } from "@/i18n/routes";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

interface Props {
  page: RouteKey;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { page } = Astro.props;
const entry = await getEntry("pages", `${lang}/${page}`);
if (!entry) throw new Error(`Missing page content: src/content/pages/${lang}/${page}.mdx`);
const { Content } = await render(entry);
const isAbout = (aboutPages as readonly RouteKey[]).includes(page);
const isTransparency = (transparencyPages as readonly RouteKey[]).includes(page);
const eyebrow = isAbout ? t("nav.about") : isTransparency ? t("nav.transparency") : undefined;
---

<Base title={`${entry.data.title} · FEGADO`}>
  <article class:list={["mx-auto px-4 pt-10 pb-20 md:px-10 md:pt-14 md:pb-[100px]", entry.data.wide ? "max-w-[1440px] xl:px-[75px]" : "max-w-[1146px]"]}>
    <PageIntro eyebrow={eyebrow} title={entry.data.title} intro={entry.data.intro} image={entry.data.image} />
    <div class="page-body">
      <Content components={{ BoardMembers, Documents, Gallery, ImageStack, LinkButton, OrganismLogos, Question }} />
    </div>
  </article>
  {isAbout && <ContactCta />}
</Base>
