---
import { ArrowUpRight } from "@lucide/astro";
import { buttonVariants } from "@/components/ui/button";
import { getLangFromUrl, routePath, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="mx-auto mb-2 max-w-[1440px] px-2 md:mb-[15px] md:px-[15px]">
  <section class="rounded-lg bg-chip px-5 py-14 text-center md:py-[75px]">
    <h2 class="mb-3 text-[30px] md:text-4xl">{t("contactCta.title")}</h2>
    <p class="mb-6 text-[15px] font-light text-ink-soft">{t("contactCta.text")}</p>
    <a class={buttonVariants()} href={routePath("contact", lang)}>{t("contactCta.button")}<ArrowUpRight /></a>
  </section>
</div>
