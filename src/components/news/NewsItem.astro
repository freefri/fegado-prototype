---
import { Image } from "astro:assets";
import { render } from "astro:content";
import { getCollection } from "astro:content";
import { ArrowLeft, ArrowUpRight, Calendar, FileText, Languages, Mail, User } from "@lucide/astro";
import RelatedItem from "./RelatedItem.astro";
import SocialIcon from "@/components/SocialIcon.astro";
import { badgeVariants } from "@/components/ui/badge";
import { eventPosters, images } from "@/data/images";
import Base from "@/layouts/Base.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import { eventPath } from "@/lib/events";
import { metaDate } from "@/lib/format";
import { categoryLabel, newsItemPath, newsListPath, type NewsEntry } from "@/lib/news";

interface Props {
  entry: NewsEntry;
  related: NewsEntry[];
}

const { entry, related } = Astro.props;
const { data } = entry;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { Content } = await render(entry);

const url = encodeURIComponent(new URL(Astro.url.pathname, Astro.site).href);
const text = encodeURIComponent(data.title);
const share = [
  { name: "linkedin", label: "LinkedIn", href: `https://www.linkedin.com/sharing/share-offsite/?url=${url}` },
  { name: "facebook", label: "Facebook", href: `https://www.facebook.com/sharer/sharer.php?u=${url}` },
  { name: "x", label: "X", href: `https://x.com/intent/post?url=${url}&text=${text}` },
  { name: "whatsapp", label: "WhatsApp", href: `https://wa.me/?text=${text}%20${url}` },
] as const;
const iconButton = "grid size-[30px] place-items-center rounded-full border border-chip-ink/70 bg-white text-chip-ink no-underline hover:bg-chip [&_svg]:size-3.5";
const back = "inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-[13px] text-chip-ink no-underline hover:bg-chip";

// Events of the same discipline as the news item, as in the design's sidebar.
const events = (await getCollection("events"))
  .filter((event) => (data.categories as string[]).includes(event.data.discipline))
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
---

<Base title={`${data.title} · FEGADO`}>
  <div class="mx-auto grid max-w-[1440px] gap-16 px-4 pt-10 pb-20 md:px-10 md:pt-14 xl:grid-cols-[minmax(0,770px)_1fr] xl:gap-[110px] xl:px-[75px]">
    <article data-pagefind-body>
      <a href={newsListPath(lang)} class={`${back} mb-6`} data-pagefind-ignore><ArrowLeft class="size-3.5" />{t("newsItem.back")}</a>

      {data.categories.length > 0 && (
        <div class="mb-3 flex flex-wrap gap-1.5" data-pagefind-ignore>
          {data.categories.map((category) => <span class={badgeVariants()}>{categoryLabel(category, t)}</span>)}
        </div>
      )}

      <h1 class="mb-6 text-[30px] leading-[1.15] md:text-4xl" lang={data.lang}>{data.title}</h1>

      <div class="mb-5 flex flex-wrap items-center justify-between gap-4" data-pagefind-ignore>
        <div class="flex flex-wrap gap-x-5 gap-y-1.5 text-[11px] font-semibold text-ink-soft">
          <span class="inline-flex items-center gap-1.5"><Calendar class="size-3" /><time datetime={data.date.toISOString()}>{metaDate(data.date, lang)}</time></span>
          {data.author && <span class="inline-flex items-center gap-1.5 uppercase"><User class="size-3" />{data.author}</span>}
        </div>
        <ul aria-label={t("newsItem.share")} class="flex list-none gap-2 p-0">
          {share.map((item) => (
            <li><a class={iconButton} href={item.href} aria-label={`${t("newsItem.share")}: ${item.label}`} rel="noopener" target="_blank"><SocialIcon name={item.name} /></a></li>
          ))}
          <li><a class={iconButton} href={`mailto:?subject=${text}&body=${url}`} aria-label={`${t("newsItem.share")}: email`}><Mail /></a></li>
        </ul>
      </div>

      {data.lang !== lang && (
        <p class="mb-6 flex items-center gap-2 rounded-md bg-chip px-4 py-3 text-sm text-chip-ink" data-pagefind-ignore>
          <Languages class="size-4 shrink-0" />{t("newsItem.otherLang")}
        </p>
      )}

      {data.image && (
        <Image
          src={images[data.image].src}
          alt={images[data.image].alt[lang]}
          widths={[800, 1540]}
          sizes="(max-width: 860px) 100vw, 770px"
          class="mb-8 aspect-[770/418] w-full rounded-md object-cover"
          style={data.imagePosition ? `object-position: ${data.imagePosition}` : undefined}
        />
      )}

      <div class="news-body" lang={data.lang}>
        <Content />
      </div>

      {data.attachments.length > 0 && (
        <section class="mt-10" data-pagefind-ignore>
          <h2 class="mb-4 text-2xl">{t("newsItem.attachments")}</h2>
          <ul class="grid list-none gap-2 p-0">
            {data.attachments.map((file) => (
              <li>
                <a href={file.url} class="flex items-center gap-3 rounded-[14px] border border-chip-ink/70 bg-white px-4 py-3 text-chip-ink no-underline hover:bg-chip" target="_blank" rel="noopener">
                  <FileText class="size-4 shrink-0" />
                  <span class="flex-1">{file.title}</span>
                  <ArrowUpRight class="size-4 shrink-0" />
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <div class="mt-12 flex flex-wrap items-center justify-between gap-4" data-pagefind-ignore>
        <a href={newsListPath(lang)} class={back}><ArrowLeft class="size-3.5" />{t("newsItem.back")}</a>
        {data.legacyUrl && <a href={data.legacyUrl} class="text-sm text-muted underline">{t("newsItem.original")}</a>}
      </div>
    </article>

    {(events.length > 0 || related.length > 0) && (
      <aside class="xl:pt-[70px]" data-pagefind-ignore>
        {events.length > 0 && (
          <section class="mb-14">
            <h2 class="mb-6 text-[28px]">{t("newsItem.relatedEvents")}</h2>
            <ul class="grid list-none gap-5 p-0">
              {events.map((entry) => (
                <RelatedItem href={eventPath(lang, entry)} title={entry.data.title} date={entry.data.date} author={entry.data.club} image={entry.data.poster} imageSrc={entry.data.posterFile ? eventPosters[entry.data.posterFile] : undefined} tags={[t(`discipline.${entry.data.discipline}`)]} />
              ))}
            </ul>
          </section>
        )}
        {related.length > 0 && (
          <section>
            <h2 class="mb-6 text-[28px]">{t("newsItem.relatedNews")}</h2>
            <ul class="grid list-none gap-5 p-0">
              {related.map((other) => (
                <RelatedItem
                  href={newsItemPath(lang, other)}
                  title={other.data.title}
                  date={other.data.date}
                  author={other.data.author || undefined}
                  image={other.data.image}
                  tags={other.data.categories.map((category) => categoryLabel(category, t))}
                />
              ))}
            </ul>
          </section>
        )}
      </aside>
    )}
  </div>
</Base>
