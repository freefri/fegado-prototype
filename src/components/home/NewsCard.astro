---
import { Image } from "astro:assets";
import { ArrowUpRight, Calendar, User } from "@lucide/astro";
import { badgeVariants } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import type { HomeNews } from "@/data/home";
import { images } from "@/data/images";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import { metaDate } from "@/lib/format";
import { cn } from "@/lib/utils";

interface Props {
  item: HomeNews;
}

const { item } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const image = images[item.image];
---

<article class="flex flex-col rounded-[14px] border border-blue-border bg-white p-[21px] transition-shadow hover:shadow-[0_12px_32px_rgb(19_68_130/0.14)]">
  <div class={cn("relative mb-[26px] aspect-[365/216] overflow-hidden rounded-xl bg-chip", item.imageIsLogo && "grid place-items-center")}>
    {item.imageIsLogo ? (
      <Image src={image.src} alt="" class="h-auto w-[46%]" />
    ) : (
      <Image
        src={image.src}
        alt=""
        widths={[400, 800]}
        sizes="(max-width: 768px) 100vw, 400px"
        class="size-full object-cover"
        style={item.imagePosition ? `object-position: ${item.imagePosition}` : undefined}
      />
    )}
    <div class="absolute top-3 right-3 flex gap-1">
      {item.categories.map((category) => <span class={badgeVariants()}>{category}</span>)}
    </div>
  </div>
  <div class="mb-2.5 flex flex-wrap gap-x-[18px] gap-y-1.5 text-xs text-ink-soft">
    <span class="inline-flex items-center gap-1.5"><Calendar class="size-3" />{metaDate(item.date, lang)}</span>
    <span class="inline-flex items-center gap-1.5"><User class="size-3" />{item.author}</span>
  </div>
  <h3 class="mb-1 line-clamp-2 text-2xl leading-[1.25]" lang={item.lang}>{item.title}</h3>
  <p class="mb-5 line-clamp-3 text-sm leading-[1.35] font-light text-ink-soft" lang={item.lang}>{item.excerpt}</p>
  <a class={buttonVariants({ className: "mt-auto self-start" })} href={item.href}>{t("news.readMore")}<ArrowUpRight /></a>
</article>
